{
  "name": "itinerisltd/wpc-builder",
  "description": "Typed, fluent WordPress Customizer fields and controls.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "itinerisltd/itineris-wp-coding-standards": "^2.0",
    "pestphp/pest": "^4.0",
    "php-stubs/wordpress-stubs": "^7.0",
    "phpstan/phpstan": "^2.0",
    "roots/wordpress": "^7.1",
    "roots/wordpress-core-installer": "^4.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-phpunit/wp-phpunit": "^7.0",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Itineris\\WpcBuilder\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Itineris\\WpcBuilder\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/Fixtures/Controls/wp-customize-control-double.php",
      "/tests/Fixtures/wp-error-double.php",
      "/tests/Fixtures/wp-post-double.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true,
      "roots/wordpress-core-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test:unit": "pest",
    "test:integration": "bash scripts/test-integration.sh",
    "stan": "phpstan analyse",
    "style:check": "phpcs",
    "style:fix": "phpcbf",
    "assets:build": "npm run build",
    "package": "bash scripts/build-release-asset.sh"
  }
}
